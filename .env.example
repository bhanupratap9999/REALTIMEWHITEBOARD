# Environment Variables (Root / PaaS Configuration)
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# MongoDB Connection String (Atlas or self-hosted)
# If omitted, application runs resiliently in In-Memory fallback mode!
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/whiteboard_ot?retryWrites=true&w=majority

# Optional: When deploying client separately (e.g., Vercel / Netlify), specify the frontend URL for CORS:
CLIENT_URL=https://your-frontend-domain.vercel.app
