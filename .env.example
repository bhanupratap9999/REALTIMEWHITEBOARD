# =====================================================
# RENDER DEPLOYMENT — Environment Variables
# Set these in your Render Dashboard:
#   Dashboard → Your Service → Environment
# =====================================================

# Server config (Render sets PORT automatically, but you can override)
PORT=10000
HOST=0.0.0.0
NODE_ENV=production

# MongoDB Atlas — REQUIRED for board persistence
# Get this from: cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/whiteboard_ot?retryWrites=true&w=majority

# =====================================================
# NO VITE_SERVER_URL NEEDED on Render!
# Frontend and backend run on the same URL.
# Socket.IO connects to window.location.origin automatically.
# =====================================================
