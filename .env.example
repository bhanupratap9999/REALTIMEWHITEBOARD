# ==========================================================
# SPLIT DEPLOYMENT (Vercel Frontend + Render Backend)
# ==========================================================
# On Render (backend), set these env vars in the dashboard:
PORT=10000
HOST=0.0.0.0
NODE_ENV=production

# MongoDB Atlas connection string (required for persistence)
# Without this, app runs in resilient in-memory mode
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/whiteboard_ot?retryWrites=true&w=majority

# URL of your Vercel frontend (add this on Render's dashboard):
CLIENT_URL=https://your-project.vercel.app

# ==========================================================
# On Vercel (frontend), set this ONE env var in the dashboard:
# Settings -> Environment Variables -> VITE_SERVER_URL
# Value: your Render backend URL, e.g.:
# VITE_SERVER_URL=https://whiteboard-backend.onrender.com
# ==========================================================
# IMPORTANT: WebSockets CANNOT run on Vercel.
# You MUST deploy the backend to Render, Railway, Fly.io, or any
# persistent Node.js host, then set VITE_SERVER_URL on Vercel.

