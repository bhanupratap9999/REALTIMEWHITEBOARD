# =======================================================
# REQUIRED FOR DEPLOYED VERCEL FRONTEND
# =======================================================
# WebSockets CANNOT run on Vercel. You must deploy the
# backend separately (Render, Railway, Fly.io, etc.)
# and paste its URL here.
#
# Set this in Vercel Dashboard:
#   Settings → Environment Variables → VITE_SERVER_URL
#
VITE_SERVER_URL=https://whiteboard-backend.onrender.com
#
# Leave blank ONLY if frontend and backend are on the
# same server/container (fullstack single-service deploy).

